# Copy to .env.local for local runs; on Netlify set these under Site configuration > Environment variables.

# Google Search Console "HTML tag" verification token: only the content value,
# e.g. abc123 from <meta name="google-site-verification" content="abc123" />.
# Not needed if the site is verified with a DNS Domain property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_DEPLOY_CONTEXT are derived in next.config.ts from
# Netlify's URL / DEPLOY_PRIME_URL / CONTEXT build variables; do not set them by hand.
