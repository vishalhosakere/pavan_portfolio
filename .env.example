# Reference for every environment variable. Production values go in Netlify > Site configuration >
# Environment variables; local overrides go in .env.local (git-ignored).

# --- CMS (Keystatic) ---
# Development only (.env.development, committed): opens the local-mode CMS at /keystatic during `npm run dev`.
# `next start` and Netlify never load it, so the admin stays closed (404) there.
# KEYSTATIC_LOCAL_ADMIN=true

# Production CMS. Leave NEXT_PUBLIC_KEYSTATIC_STORAGE unset to keep /keystatic and /api/keystatic closed.
# GitHub mode: editors sign in with GitHub; only collaborators with write access to the repo can save.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# NEXT_PUBLIC_KEYSTATIC_REPO=vishalhosakere/pavan_portfolio
# Created by Keystatic at https://<site>/keystatic/setup (the GitHub App wizard):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Alternative for an editor without a GitHub account: Keystatic Cloud.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=cloud
# NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=your-team/your-project

# --- Search and analytics ---
# Google Search Console "HTML tag" verification token: only the content value,
# e.g. abc123 from <meta name="google-site-verification" content="abc123" />.
# Not needed if the site is verified with a DNS Domain property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_DEPLOY_CONTEXT are derived in next.config.ts from
# Netlify's URL / DEPLOY_PRIME_URL / CONTEXT build variables; do not set them by hand.
